@comment{
  Paste one BibTeX entry per paper below. The home page and publication.html?id=<key> are built from this file.

  Standard fields (title, author, year, month, journal/booktitle, url, doi, eprint) are rendered and kept in "Copy BibTeX".
  Site-only fields (shown on the site, stripped from "Copy BibTeX"):
    github, project, pdf, video, slides : link buttons
    tldr                                : one-line subtitle on the paper page
    cover                               : hero image file inside posts/<key>/, e.g. cover.jpg
    abstract                            : shown when there is no blog post

  Blog post (optional): create a folder posts/<key>/ with an index.md in Markdown, and put its images and
  files in the same folder. Reference them by filename: ![Overview](figure1.png). Each "## Heading" becomes
  a numbered section, $x$ and $$x$$ render as math, and raw HTML (<figure>, <video>, <iframe>) works too.

  Example:
  @inproceedings[petroni2026example,
    title     = [A Short Paper Title],
    author    = [Sigillo, Luigi and Petroni, Fabio],
    booktitle = [Conference Name],
    year      = [2026],
    month     = [September],
    eprint    = [2609.01234],
    github    = [https://github.com/petronilab/example],
    tldr      = [One sentence on what the paper does.],
    cover     = [cover.jpg]
  ]
  (brackets stand in for curly braces so this example is not parsed)
}

@misc{ai2026recursiveknowledgeconstruction,
      title={Does Recursive Knowledge Construction Help Agents Verify Consensus Claims in Science?},
      author={Lun Ai and Yu-Heng Wu and Jonathan Schaul and Leonie Küchenhoff and Denes Turei and Francesco Carli and Fabio Petroni and Aurelien Dugourd and Julio Saez-Rodriguez},
      year={2026},
      eprint={2610.40906},
      archivePrefix={arXiv},
      primaryClass={cs.AI},
      url={https://arxiv.org/abs/2610.40906},
      month={October},
      abstract={Recent scientific agents build knowledge recursively by retrieving evidence, constructing an intermediate state, and judging whether that state contains sufficient information. These agents are evaluated end-to-end, usually without ground truth, so the effect of each design choice is unknown. Here, we examined two design axes: (1) what the recursion builds (the state of evidence) and (2) what controls it (the judge that decides when to stop). To measure them, we defined consensus scientific claim verification and measured these effects on this task, where a system must establish a claim's consensus stance from the open literature. We built a new consensus claim dataset, ProClaim-eval, including 718 claims with SUPPORT and REFUTE gold labels from five expert-curated databases spanning molecular biology, nuclear physics, and astronomy. Our instrument, ProClaim, persists an evidence state outside the model's context, so each axis can be studied with the other held fixed. Against verification systems and general-purpose agent harnesses, ProClaim ranks among the top three, with a significant advantage over the harnesses. We found that the evidence state improves performance over in-context accumulation, and it also matters what is stored in it. In addition, a trained judge that reads the evidence state performs better than fixed-round stopping. A judge trained separately and never exposed to ProClaim-eval achieves the highest agreement with the gold labels on three of five subsets, where it matches the off-the-shelf Claude Sonnet 4.6 judge and outperforms Claude Haiku 4.5. Our results support recursively maintaining a structured evidence state outside the model's context as an effective design for verifying claims in scientific agents.},
}

@article{carli2026karenina,
      title={Turning Domain Expertise into Multi-Dimensional Evaluation of Biomedical AI with Karenina},
      author={Francesco Carli and Polina Rusina and Lun Ai and Leonie Küchenhoff and Paul Ka Po To and Ellen M. McDonagh and Sebastian Lobentanzer and Fabio Petroni and Aurelien Dugourd and David Ochoa and Julio Saez-Rodriguez},
      journal={bioRxiv},
      year={2026},
      month={September},
      doi={10.64898/2026.09.01.748513},
      url={https://www.biorxiv.org/content/10.64898/2026.09.01.748513v1},
      abstract={Language models and agents are increasingly used in biomedicine, but current benchmarks reward correct answers even when the underlying reasoning is flawed. Here we introduce Karenina, an open-source framework that turns expert knowledge into multi-dimensional evaluations of questions, conversations and autonomous agents. Illustrated in Question-Answer pairs, multi-turn conversations and autonomous data-analysis, these dimensions together moves evaluation beyond scoring, enabling trustworthy decision-making with AI in biomedicine.},
}

